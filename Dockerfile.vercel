# Stage 1: Build the artifact using Maven and Eclipse Temurin JDK 17
FROM maven:3.9.6-eclipse-temurin-17 AS build
WORKDIR /app

# Cache dependencies effectively
COPY pom.xml .
RUN mvn dependency:go-offline -B

# Copy source and build a production-ready fat JAR
COPY src ./src
RUN mvn clean package -DskipTests

# Stage 2: Serve the API using a lightweight JRE environment
FROM eclipse-temurin:17-jre-alpine
WORKDIR /app

# Copy the built JAR from the previous stage
COPY --from=build /app/target/*.jar app.jar

# Expose Vercel's proxy channel
EXPOSE 80

# Execute Spring Boot using the runtime environment configuration
ENTRYPOINT ["java", "-jar", "app.jar"]
